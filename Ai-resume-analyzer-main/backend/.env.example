# Backend-only environment (for running Spring Boot without Docker)
DB_URL=jdbc:postgresql://localhost:5432/resume_analyzer
DB_USERNAME=resume_user
DB_PASSWORD=resume_pass
SERVER_PORT=8080

JWT_SECRET=replace_with_a_long_random_secret_at_least_64_characters_long_value
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

CORS_ALLOWED_ORIGINS=http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true

FILE_STORAGE_LOCATION=./storage/resumes
SEED_ENABLED=true

# Optional SMTP (leave blank to log reset links to console)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
