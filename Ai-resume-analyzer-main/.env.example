# ============================================================
#  AI Resume Analyzer — environment configuration
#  Copy this file to ".env" and adjust values before running.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=resume_analyzer
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8080
# Use a 64+ character random secret in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_characters_long_value
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- OpenAI ----
# Leave OPENAI_API_KEY blank to use the built-in deterministic analyzer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true

# ---- Frontend ----
FRONTEND_PORT=3000
